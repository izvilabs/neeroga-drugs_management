generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  STAFF
  DEPARTMENT_MANAGER
  STATIONERY_MANAGER
  DRUGS_MANAGER
  ADMIN
}

enum UserStatus {
  ACTIVE
  BLOCKED
}

enum DepartmentStatus {
  ACTIVE
  INACTIVE
}

enum ItemStatus {
  ACTIVE
  INACTIVE
  DELETED
}

enum ItemType {
  DRUGS
  INVENTORY
}

enum LocationType {
  MAIN_STORE // admin
  MANAGER_STORE
  DEPARTMENT 
  OTHER  
}

enum TransferType {
  MANUAL
  REQUEST_BASED
  DEPARTMENT_TO_DEPARTMENT
}   

model User {
  id          String      @id @default(uuid())
  email       String      @unique
  firstName   String   
  lastName    String
  password    String
  role        Role        @default(STAFF)
  number      String?     @unique
  profileImage String?    
  status      UserStatus  @default(ACTIVE)
  lastLogin   DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  privilages  String[]    @default([])

  department       Department[]
  stationeryBatche StationeryBatche[]
  drugsBatche      DrugsBatche[]
}

model Department {
  
  id      String      @id @default(uuid())
  code    String
  name    String
  status  DepartmentStatus    @default(ACTIVE)
  discription   String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  user User[]
  drugsBatche    DrugsBatche[]
  stationeryBatche StationeryBatche[]
}

model DrugCategoty {
  id      String      @id @default(uuid())
  code    String
  name    String
  discription String?

  drug    Drug[]
}

model Drug {
  id      String      @id @default(uuid())
  code    String
  name    String
  type    ItemType
  bufferlevel Int         @default(0)
  status      ItemStatus @default(ACTIVE)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  categoryId    String
  category      DrugCategoty   @relation(fields: [categoryId] , references: [id])

  drugBatche DrugsBatche[]
}

model StationeryCategoty {
  id      String      @id @default(uuid())
  code    String
  name    String
  discription String?

  stationery    Stationery[]
}

model Stationery {
  id      String      @id @default(uuid())
  code    String
  name    String
  type    ItemType
  bufferlevel Int         @default(0)
  status      ItemStatus @default(ACTIVE)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  categoryId    String
  stationeryCategoty    StationeryCategoty   @relation(fields: [categoryId] , references: [id])

  stationeryBatche StationeryBatche[]
}

model DrugsBatche {
  id          String        @id @default(uuid())
  price       String
  stock       Int
  issuedate   DateTime      @default(now())
  expireDate  DateTime
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  departmentId  String
  userId        String
  drugId        String
  department    Department  @relation(fields: [departmentId] , references: [id])
  drug          Drug        @relation(fields: [drugId] , references: [id])
  user          User        @relation(fields: [userId] , references: [id])
}

model StationeryBatche {
  id          String        @id @default(uuid())
  price       String
  stock       Int
  issuedate   DateTime      @default(now())
  expireDate  DateTime
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  departmentId        String
  userId              String
  StationeryId        String
  department          Department  @relation(fields: [departmentId] , references: [id])
  stationery          Stationery  @relation(fields: [StationeryId] , references: [id])
  user                User        @relation(fields: [userId] , references: [id])
}

model Request {
  id      String    @id @default(uuid())
  transferType TransferType 

  
}

model location {
  id           String       @id @default(cuid())
  name         String
  type         LocationType
  managerId    String?      @unique //if MANAGER_STORE
  departmentId String?      @unique // if DEPARTMENT
  createdAt    DateTime     @default(now())

}

model StockTransfer {
  id                String      @id @default(ulid())
  isConfirmed       Boolean         @default(false)
  confirmedAt       DateTime?
  createdAt         DateTime        @default(now())
  transationType    TransferType
  
  FromLocation     String
  ToLocation       String
  requestId         String?
  transferredById   String

  

}