generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

//users , departments , drug categories , inventory categrories , drugs , inventory , transactionLogs , default transactions , 

enum UserRole {
  ADMIN
  DRUGS_MANAGER
  INVENTORY_MANAGER
  DEPARTMENT_MANAGERS   // select department managers only for the department they are assigned to
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum DepartmentStatus {
  ACTIVE
  INACTIVE
  PROCESSING
}


enum TransferStatus { // for stock transfer logs for auditing purposes
  DRAFT
  DISPATCHED
  PARTIALLY_DISPATCHED
  RECEIVED
  CANCELLED
  REJECTED
  APPROVED
} 


model User {
  id           String   @id @default(uuid()) @db.Uuid
  fullName     String   
  email        String?   @unique
  passwordHash String   
  role         UserRole  
  phoneNumber  String? 
  departmentId String?
  isActive     UserStatus @default(ACTIVE)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  // department Department? @relation("DepartmentUsers", fields: [departmentId], references: [DepartmentId])
  // createdTransfers  StockTransfer[] @relation("TransferCreatedBy")
  // receivedTransfers StockTransfer[]   
  // requestedRequests StockRequest[] @relation("RequestedBy")
  // stockIssues       StockIssue[]
  // stockAdjustments  StockAdjustment[]
  // stockMovements    StockMovement[]
  // expiryChanges     ExpiryDateHistory[]

  @@index([departmentId])
  @@index([role])
  @@map("users")
}

model Department {
  DepartmentId  String  @id 
  name          String  @unique
  description   String?
  isActive      DepartmentStatus @default(PROCESSING)

  // users         User[] @relation("DepartmentUsers")
  // transfers     StockTransfer[] @relation("TransferFromDepartment")
  // receivedTransfers StockTransfer[] @relation("TransferToDepartment")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("departments")
}

